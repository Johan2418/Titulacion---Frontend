# URL base de la API REST del backend (NestJS)
VITE_API_URL=http://localhost:3000/api/v1
# true: usa los mocks de MSW en lugar del backend real
VITE_USE_MOCKS=true
# Zona horaria institucional para mostrar fechas (RNF-30)
VITE_TIMEZONE=America/Guayaquil
# OIDC institucional (RNF-01). Ignorado cuando VITE_USE_MOCKS=true
VITE_OIDC_AUTHORITY=https://sso.institucion.edu/realms/titulacion
VITE_OIDC_CLIENT_ID=titulacion-frontend
VITE_OIDC_SCOPE=openid profile email
