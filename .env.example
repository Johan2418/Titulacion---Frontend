# URL base de la API REST. Con el proxy de Vite (desarrollo) o de Nginx (contenedor) use /api/v1.
VITE_API_URL=/api/v1
# Solo desarrollo: dirección del backend NestJS al que Vite redirige /api/v1
VITE_BACKEND_URL=http://127.0.0.1:3000
# Zona horaria institucional para mostrar fechas (RNF-30)
VITE_TIMEZONE=America/Guayaquil
