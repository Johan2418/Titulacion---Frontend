# URL base de la API REST. Con el proxy de Vite (desarrollo) o de Nginx (contenedor) use /api/v1.
VITE_API_URL=/api/v1
# Solo desarrollo: dirección del backend NestJS al que Vite redirige /api/v1
VITE_BACKEND_URL=http://127.0.0.1:3000
# Zona horaria institucional para mostrar fechas (RNF-30)
VITE_TIMEZONE=America/Guayaquil
# Orígenes (separados por coma) desde los que se permite descargar archivos prefirmados, p. ej.
# https://s3.example.com. Vacío: se acepta cualquier URL https (http solo en localhost).
# En producción defínalo siempre con el origen real del almacenamiento.
VITE_STORAGE_ORIGINS=
# Solo contenedor (variable de ejecución de Nginx, no de compilación): CIDR del balanceador que
# termina TLS delante de este contenedor, para tomar la IP real del cliente de X-Forwarded-For.
# Vacío si el contenedor está expuesto directamente.
TRUSTED_PROXY_CIDR=
# Solo contenedor (Nginx): límites por IP. Holgados porque un campus puede compartir una IP (NAT).
RATE_LIMIT_AUTH=20r/s
RATE_LIMIT_AUTH_BURST=40
RATE_LIMIT_API=100r/s
RATE_LIMIT_API_BURST=200
LIMIT_CONN_PER_IP=100
# Conexiones simultáneas por IP a las rutas de subida de archivos (por NAT, no baje de unas pocas).
LIMIT_CONN_UPLOAD_PER_IP=10
